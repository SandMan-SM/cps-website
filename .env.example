# Optional public search verification and analytics configuration.
# Real secret values belong in ignored local files or the hosting environment.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# The development-only Omni bridge uses a temporary shared server-side secret.
